---
import { projets, projets42, profil } from '../data/contenu';
---

<section id="projets">
  <div class="container">
    <div class="section-head reveal">
      <p class="prompt">ls ~/projets</p>
      <h2>Projets</h2>
    </div>

    <div class="projets">
      {
        projets.map((p, i) => (
          <article class="projet reveal">
            <div class="projet__top">
              <span class="projet__num mono">{String(i + 1).padStart(2, '0')}</span>
              {p.site && (
                <span class="projet__live mono">
                  <span class="dot" aria-hidden="true" />
                  en ligne
                </span>
              )}
              {p.prive && <span class="projet__prive mono">projet privé</span>}
            </div>
            <h3>{p.nom}</h3>
            <p class="projet__desc">{p.description}</p>
            <ul class="tags">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            {(p.site || p.code) && (
            <div class="projet__links">
              {p.site && (
                <a href={p.site} class="link-arrow" target="_blank" rel="noopener noreferrer">
                  voir le site ↗
                </a>
              )}
              {p.code && (
                <a href={p.code} class="link-arrow" target="_blank" rel="noopener noreferrer">
                  {(p.codeLabel ?? 'code').toLowerCase()} ↗
                </a>
              )}
            </div>
            )}
          </article>
        ))
      }
    </div>

    <div class="cursus reveal">
      <div class="cursus__bar mono" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>~/42</p>
      </div>
      <div class="cursus__body">
        <p class="cursus__cmd mono"><span class="muted">$</span> ls ~/42 --projets</p>
        <ul class="cursus__list">
          {
            projets42.map((p) => (
              <li>
                <a href={p.lien} target="_blank" rel="noopener noreferrer" class="mono cursus__nom">
                  {p.nom}
                </a>
                <span class="cursus__resume">{p.resume}</span>
              </li>
            ))
          }
        </ul>
        <a href={profil.github + '?tab=repositories'} class="link-arrow" target="_blank" rel="noopener noreferrer">
          tous mes dépôts sur GitHub ↗
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .projets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 960px) {
    .projets {
      grid-template-columns: 1fr;
    }
  }
  .projet {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.25s, transform 0.25s;
  }
  .projet:hover {
    border-color: rgba(62, 224, 143, 0.5);
    transform: translateY(-3px);
  }
  .projet__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .projet__num {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .projet__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--accent);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .projet h3 {
    font-size: 1.375rem;
  }
  .projet__desc {
    color: var(--muted);
    font-size: 0.9688rem;
    flex: 1;
  }
  .projet__prive {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
  .projet__links {
    display: flex;
    gap: 1.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .cursus {
    margin-top: 3rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cursus__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .cursus__bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }
  .cursus__bar p {
    margin-left: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cursus__body {
    padding: 1.5rem 1.75rem 1.75rem;
  }
  .cursus__cmd {
    font-size: 0.875rem;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .muted {
    color: var(--muted);
  }
  .cursus__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.85rem;
  }
  .cursus__list li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    font-size: 0.9375rem;
  }
  .cursus__nom {
    color: var(--text);
    font-size: 0.875rem;
  }
  .cursus__nom:hover {
    color: var(--accent);
  }
  .cursus__resume {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .cursus__body {
      padding: 1.25rem;
    }
    .cursus__list li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
